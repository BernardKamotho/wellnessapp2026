<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#A4EDDD"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <!--    Below is a textview  -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Health And Wellness"
            android:textSize="33sp"
            android:textAlignment="center"
            android:textStyle="bold"
            android:layout_marginTop="15dp"
            android:textColor="#C107C1" />

        <!--    Below is our image -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:src="@drawable/wellness"
            android:layout_marginTop="15dp"
            android:scaleType="centerCrop" />


        <!--    Below are our buttons -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Healthy Recipes"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#EFF8EF"
            android:padding="12dp"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:backgroundTint="#232"
            android:id="@+id/healthrecipes" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Nutrition Advice"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#EFF8EF"
            android:padding="12dp"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:backgroundTint="#232"
            android:id="@+id/nutritionadvice" />

    </LinearLayout>

</ScrollView>